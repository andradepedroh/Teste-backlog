# spec-status-report — Variáveis de ambiente
# Copie este ficheiro para .env (na pasta desta skill) e preencha os valores reais.
# NUNCA versione o .env com valores reais.
#
# O carregamento é o mesmo padrão da spec-tasks-azure: se a skill spec-tasks-azure
# já tiver um .env preenchido no mesmo espelho, esta skill o reaproveita
# automaticamente (não é preciso duplicar credenciais).

# ——— Azure DevOps (opcional; sem isto o coletor cai no fallback MCP/snapshot) ———
AZURE_DEVOPS_PAT=seu-personal-access-token-aqui
AZURE_DEVOPS_ORG=sua-organizacao
AZURE_DEVOPS_PROJECT=seu-projeto

# Versão da API (opcional)
# AZURE_DEVOPS_API_VERSION=7.1

# Filtros opcionais da consulta WIQL (equivalentes às flags --azure-area / --azure-iteration)
# AZURE_DEVOPS_AREA_PATH=MeuProjeto\Modulo
# AZURE_DEVOPS_ITERATION_PATH=MeuProjeto\Sprint 12

# ——— Limites de execução de testes (opcional) ———
# STATUS_REPORT_TEST_TIMEOUT_S=900        # timeout por runner (default 900s)
# STATUS_REPORT_MAX_IMAGE_KB=1536         # cap por imagem embutida em base64
# STATUS_REPORT_MAX_CODE_FILES=20000      # cap de arquivos varridos no inventário de código
