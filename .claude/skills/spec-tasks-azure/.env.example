# spec-tasks-azure — Variáveis de ambiente
# Copie este ficheiro para .env e preencha os valores reais.
# NUNCA versione o .env com valores reais.

# ——— Credenciais obrigatórias ———
AZURE_DEVOPS_PAT=seu-personal-access-token-aqui
AZURE_DEVOPS_ORG=sua-organizacao
AZURE_DEVOPS_PROJECT=seu-projeto

# ——— Epic pai (opcional — override de metadata.azureDevOps.epicWorkItemId) ———
# AZURE_DEVOPS_EPIC_WORK_ITEM_ID=12345

# ——— Work Item Types (opcional) ———
# Única fonte real do nome do WIT usado nas criações (metadata.azureDevOps.workItemTypes.<nível>.wit
# é só referência/documentação no tasks.json — não é lido pelo código).
# Ajustar se o processo ADO usar nomes diferentes dos defaults
# AZURE_DEVOPS_WIT_EPIC=Epic
# AZURE_DEVOPS_WIT_FEATURE=Feature
# AZURE_DEVOPS_WIT_USER_STORY=User Story
# AZURE_DEVOPS_WIT_TASK=Task

# ——— Work Item Types Operacionais (opcional — EloCore) ———
# Usados quando Feature/Story tem workItemType !== FEATURE | USER_STORY
# Fallback: ENABLER/SPIKE/TECHNICAL_DEBT → User Story; BUG → Bug
# AZURE_DEVOPS_WIT_ENABLER=Enabler
# AZURE_DEVOPS_WIT_SPIKE=Spike
# AZURE_DEVOPS_WIT_TECHNICAL_DEBT=Technical Debt
# AZURE_DEVOPS_WIT_BUG=Bug

# ——— Versão da API ADO (opcional) ———
# AZURE_DEVOPS_API_VERSION=7.1

# ——— Opções de depuração ———
# AZURE_DEVOPS_APPEND_FULL_JSON_PAYLOAD=1   # Anexar JSON completo à descrição dos work items
# AZURE_DEVOPS_SKIP_STORY_ACCEPTANCE_CRITERIA=1  # Omitir critérios de aceitação

# ——— Modo _change (upsert) ———
# Não requer variáveis de ambiente novas. Ativa-se por metadata.changeMode === true no JSON
# ou pela flag CLI --change. Correlação ID lógico -> work item: tag 'logical-id:<ID>' (gravada
# automaticamente em toda criação) ou, para itens legados, um id-map.json passado via --id-map.
#   node cli.mjs --input tasks-complementary_change-XXX.json --project SEU_PROJETO --change \
#     --id-map id-map.json     # id-map.json: {"TASK-XXX-XXX": 12345, "STORY-XXX": 678}
