{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "azure-devops-process-template",
  "description": "Entrada opcional para spec-tasks — blueprint de processo Azure DevOps (Custom Agile).",
  "type": "object",
  "required": ["workItemTypes", "metadata"],
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "targetProvider": { "type": "string" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "processTemplate": {
      "type": "object",
      "properties": {
        "templateName": { "type": "string" },
        "processOwner": { "type": "string" }
      }
    },
    "workItemTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "referenceName": { "type": "string" },
          "inherits": { "type": "string" },
          "isDisabled": { "type": "boolean" },
          "description": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "referenceName": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "defaultValue": {}
              }
            }
          }
        }
      }
    },
    "processRules": { "type": "array" },
    "workflowStates": { "type": "object" },
    "boardConfiguration": { "type": "array" },
    "teams": { "type": "array" }
  }
}
